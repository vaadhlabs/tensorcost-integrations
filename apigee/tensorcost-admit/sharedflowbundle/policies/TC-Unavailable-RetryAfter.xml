<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- TensorCost for Apigee. Apache-2.0. See README.md. -->
<RaiseFault name="TC-Unavailable-RetryAfter">
    <DisplayName>TC-Unavailable-RetryAfter</DisplayName>
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="Retry-After">{tensorcost.retry_after}</Header>
            </Headers>
            <Payload contentType="application/json">{tensorcost.error_body}</Payload>
            <StatusCode>503</StatusCode>
            <ReasonPhrase>Service Unavailable</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
