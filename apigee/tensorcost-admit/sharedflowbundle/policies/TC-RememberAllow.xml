<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- TensorCost for Apigee. Apache-2.0. See README.md. -->
<PopulateCache name="TC-RememberAllow">
    <DisplayName>TC-RememberAllow</DisplayName>
    <CacheKey>
        <Prefix>tensorcost</Prefix>
        <KeyFragment ref="tensorcost.cache_key"/>
    </CacheKey>
    <ExpirySettings>
        <TimeoutInSeconds ref="tensorcost.cache_ttl">0</TimeoutInSeconds>
    </ExpirySettings>
    <Source>tensorcost.cache_value</Source>
</PopulateCache>
