<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- TensorCost for Apigee. Apache-2.0. See README.md. -->
<RaiseFault name="TC-Unavailable">
    <DisplayName>TC-Unavailable</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{tensorcost.error_body}</Payload>
            <StatusCode>503</StatusCode>
            <ReasonPhrase>Service Unavailable</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
